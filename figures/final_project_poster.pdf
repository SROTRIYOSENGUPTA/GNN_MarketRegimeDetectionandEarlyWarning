<svg xmlns="http://www.w3.org/2000/svg" width="2400" height="1500" viewBox="0 0 2400 1500" role="img" aria-labelledby="title desc">
  <title id="title">Dynamic Regime GNN final project poster</title>
  <desc id="desc">Heterogeneous GNN with real Bloomberg supplier, customer and institutional-holder edges, evaluated on cross-sectional S&amp;P 500 return rank prediction with statistical significance across multiple seeds and walk-forward cutoffs.</desc>
  <defs>
    <linearGradient id="topBand" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#0f766e"/>
      <stop offset="42%" stop-color="#2563eb"/>
      <stop offset="72%" stop-color="#7c3aed"/>
      <stop offset="100%" stop-color="#d97706"/>
    </linearGradient>
    <pattern id="dotGrid" width="38" height="38" patternUnits="userSpaceOnUse">
      <circle cx="4" cy="4" r="1.2" fill="#334155" opacity="0.07"/>
    </pattern>
    <filter id="softShadow" x="-8%" y="-8%" width="116%" height="116%">
      <feDropShadow dx="0" dy="5" stdDeviation="8" flood-color="#475569" flood-opacity="0.14"/>
    </filter>
    <linearGradient id="heroBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ecfdf5"/>
      <stop offset="100%" stop-color="#d1fae5"/>
    </linearGradient>
    <linearGradient id="dataBg" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#fef3c7"/>
      <stop offset="100%" stop-color="#fde68a"/>
    </linearGradient>
    <style>
      text { font-family: "Aptos", "Helvetica Neue", Arial, sans-serif; letter-spacing: 0; }
      .title { fill: #0f172a; font-size: 44px; font-weight: 820; }
      .subtitle { fill: #334155; font-size: 20px; font-weight: 500; }
      .authors { fill: #075985; font-size: 16px; font-weight: 700; }
      .eyebrow { fill: #0369a1; font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0; }
      .eyebrow-hero { fill: #047857; font-size: 14px; font-weight: 820; text-transform: uppercase; letter-spacing: 0.5px; }
      .eyebrow-data { fill: #92400e; font-size: 14px; font-weight: 820; text-transform: uppercase; letter-spacing: 0.5px; }
      .section { fill: #0f172a; font-size: 24px; font-weight: 820; }
      .section-hero { fill: #064e3b; font-size: 28px; font-weight: 880; }
      .section-data { fill: #78350f; font-size: 26px; font-weight: 860; }
      .subhead { fill: #0f766e; font-size: 15px; font-weight: 800; }
      .body { fill: #1e293b; font-size: 15px; font-weight: 520; }
      .body2 { fill: #334155; font-size: 13.5px; font-weight: 500; }
      .body-data { fill: #44403c; font-size: 14px; font-weight: 540; }
      .tiny { fill: #64748b; font-size: 11.5px; font-weight: 580; }
      .code { fill: #0f4c81; font-size: 13px; font-family: "SFMono-Regular", "Consolas", monospace; font-weight: 550; }
      .metric { fill: #0f172a; font-size: 34px; font-weight: 860; }
      .metric2 { fill: #0f172a; font-size: 28px; font-weight: 850; }
      .metric-big { fill: #047857; font-size: 72px; font-weight: 880; }
      .metric-mid { fill: #047857; font-size: 38px; font-weight: 860; }
      .metric-data { fill: #92400e; font-size: 30px; font-weight: 860; }
      .metric-pval { fill: #b91c1c; font-size: 17px; font-weight: 820; font-family: "SFMono-Regular", "Consolas", monospace; }
      .metric-label { fill: #0369a1; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0; }
      .metric-label-hero { fill: #047857; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
      .metric-label-data { fill: #92400e; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
      .panel { fill: #ffffff; fill-opacity: 0.96; stroke: #cbd5e1; stroke-width: 1.1; }
      .panel-hero { fill: url(#heroBg); stroke: #10b981; stroke-width: 2; }
      .panel-data { fill: url(#dataBg); stroke: #d97706; stroke-width: 2; }
      .panel-soft { fill: #f8fafc; stroke: #cbd5e1; stroke-width: 1; }
      .blue { fill: #eff6ff; stroke: #93c5fd; stroke-width: 1; }
      .green { fill: #ecfdf5; stroke: #86efac; stroke-width: 1; }
      .amber { fill: #fffbeb; stroke: #fcd34d; stroke-width: 1; }
      .rose { fill: #fff1f2; stroke: #fda4af; stroke-width: 1; }
      .chip { fill: #e0f2fe; stroke: #38bdf8; stroke-width: 1; }
      .chip2 { fill: #f0fdf4; stroke: #4ade80; stroke-width: 1; }
      .chip3 { fill: #fef3c7; stroke: #fbbf24; stroke-width: 1; }
      .chip-gh { fill: #0f172a; stroke: #0f172a; stroke-width: 1; }
      .chip-text { fill: #0f172a; font-size: 13px; font-weight: 760; }
      .chip-text-gh { fill: #ffffff; font-size: 13px; font-weight: 760; }
      .axis { stroke: #475569; stroke-width: 1.2; }
      .gridline { stroke: #cbd5e1; stroke-width: 0.9; }
      .baseline-line { stroke: #dc2626; stroke-width: 1.5; stroke-dasharray: 5 4; }
      .bar-label { fill: #334155; font-size: 12px; font-weight: 700; }
      .bar-value { fill: #0f172a; font-size: 12px; font-weight: 780; }
      .bar-value-hero { fill: #ffffff; font-size: 13px; font-weight: 820; }
      .legend { fill: #334155; font-size: 12.5px; font-weight: 650; }
      .link { fill: #075985; font-size: 11.5px; font-weight: 740; text-decoration: underline; }
      .line { fill: none; stroke-width: 2.8; stroke-linejoin: round; stroke-linecap: round; }
      .star { fill: #b91c1c; font-size: 14px; font-weight: 820; }
      .lock-icon { fill: #92400e; font-size: 20px; font-weight: 820; }
    </style>
  </defs>

  <rect width="2400" height="1500" fill="#fbfaf6"/>
  <rect width="2400" height="1500" fill="url(#dotGrid)"/>
  <rect x="0" y="0" width="2400" height="18" fill="url(#topBand)"/>
  <rect x="0" y="1440" width="2400" height="60" fill="#0f172a" opacity="0.05"/>

  <!-- ===== TITLE BANNER ===== -->
  <g transform="translate(60,40)">
    <rect x="0" y="8" width="2280" height="164" rx="22" fill="#475569" opacity="0.10"/>
    <rect class="panel" x="0" y="0" width="2280" height="164" rx="22"/>
    <rect x="0" y="0" width="2280" height="8" rx="4" fill="url(#topBand)"/>
    <text class="title" x="36" y="56">Dynamic Regime GNN for Market Regime Detection</text>
    <text class="title" x="36" y="98">and Early Warning</text>
    <text class="subtitle" x="38" y="126">Dynamic heterogeneous graph learning over daily stock-market snapshots.</text>
    <text class="authors" x="38" y="150">Srotriyo Sengupta and Yifan Zhang</text>
    <g transform="translate(1430,38)">
      <rect class="chip" x="0" y="0" width="170" height="38" rx="13"/>
      <text class="chip-text" x="85" y="24" text-anchor="middle">Setting A: 30 stocks</text>
      <rect class="chip2" x="186" y="0" width="186" height="38" rx="13"/>
      <text class="chip-text" x="279" y="24" text-anchor="middle">Setting B: 500 stocks</text>
      <rect class="chip3" x="388" y="0" width="160" height="38" rx="13"/>
      <text class="chip-text" x="468" y="24" text-anchor="middle">NVIDIA H200 / A100</text>
      <rect class="chip-gh" x="564" y="0" width="218" height="38" rx="13"/>
      <text class="chip-text-gh" x="673" y="24" text-anchor="middle">&#9733; View code on GitHub</text>
    </g>
    <text class="tiny" x="1432" y="120">Dual task: regime classification + stress early warning over t+5..t+20</text>
    <text class="link" x="1432" y="148">github.com/SROTRIYOSENGUPTA/GNN_MarketRegimeDetectionandEarlyWarning</text>
  </g>

  <!-- ===== HERO: SETTING C (taller now, h=320) ===== -->
  <g transform="translate(60,220)">
    <rect x="0" y="8" width="2280" height="320" rx="22" fill="#10b981" opacity="0.18"/>
    <rect class="panel-hero" x="0" y="0" width="2280" height="320" rx="22"/>
    <text class="eyebrow-hero" x="32" y="38">Setting C &#8901; Cross-Sectional Rank &#8901; New Headline Results</text>
    <text class="section-hero" x="32" y="78">Real Bloomberg Edges Significantly Outperform Every Ablation</text>
    <text class="body-data" x="32" y="106" fill="#065f46">Target: rank-quantile of forward 5-day return per stock per date (Down / Neutral / Up). n=5 seeds, paired t-tests.</text>

    <!-- Hero big metric block -->
    <g transform="translate(32,130)">
      <rect x="0" y="0" width="290" height="124" rx="16" fill="#ffffff" stroke="#10b981" stroke-width="2"/>
      <text class="metric-big" x="20" y="76">0.370</text>
      <text class="metric-label-hero" x="20" y="100">Bloomberg macro-F1</text>
      <text class="tiny" x="20" y="118">mean &#177; 0.004 (5 seeds)</text>
    </g>

    <!-- Three significance blocks -->
    <g transform="translate(342,130)">
      <rect x="0" y="0" width="288" height="124" rx="16" fill="#ffffff" stroke="#86efac"/>
      <text class="metric-mid" x="20" y="52">+0.018</text>
      <text class="metric-label-hero" x="20" y="76">vs no-graph LSTM</text>
      <text class="metric-pval" x="20" y="106">p &lt; .001</text>

      <rect x="304" y="0" width="288" height="124" rx="16" fill="#ffffff" stroke="#86efac"/>
      <text class="metric-mid" x="324" y="52">+0.020</text>
      <text class="metric-label-hero" x="324" y="76">vs correlation-only</text>
      <text class="metric-pval" x="324" y="106">p &lt; .01</text>

      <rect x="608" y="0" width="288" height="124" rx="16" fill="#ffffff" stroke="#86efac"/>
      <text class="metric-mid" x="628" y="52">+0.015</text>
      <text class="metric-label-hero" x="628" y="76">vs sector/synthetic proxy</text>
      <text class="metric-pval" x="628" y="106">p &lt; .05</text>
    </g>

    <!-- Inline bar chart (4 configs) -->
    <g transform="translate(1310,148)">
      <line class="axis" x1="0" y1="100" x2="540" y2="100"/>
      <line class="gridline" x1="0" y1="50" x2="540" y2="50"/>
      <line class="gridline" x1="0" y1="0" x2="540" y2="0"/>
      <line class="baseline-line" x1="0" y1="100" x2="540" y2="100"/>
      <text class="tiny" x="-8" y="104" text-anchor="end">.33</text>
      <text class="tiny" x="-8" y="54" text-anchor="end">.36</text>
      <text class="tiny" x="-8" y="4" text-anchor="end">.37</text>
      <text class="tiny" x="546" y="104">random</text>

      <rect x="40" y="0" width="80" height="100" rx="6" fill="#10b981" stroke="#047857" stroke-width="1.5"/>
      <text class="bar-value-hero" x="80" y="20" text-anchor="middle">.370</text>
      <text class="bar-label" x="80" y="120" text-anchor="middle">Bloomberg</text>

      <rect x="160" y="37" width="80" height="63" rx="6" fill="#94a3b8" stroke="#475569"/>
      <text class="bar-value" x="200" y="30" text-anchor="middle">.355</text>
      <text class="bar-label" x="200" y="120" text-anchor="middle">Proxy</text>

      <rect x="280" y="50" width="80" height="50" rx="6" fill="#94a3b8" stroke="#475569"/>
      <text class="bar-value" x="320" y="43" text-anchor="middle">.350</text>
      <text class="bar-label" x="320" y="120" text-anchor="middle">CorrOnly</text>

      <rect x="400" y="45" width="80" height="55" rx="6" fill="#94a3b8" stroke="#475569"/>
      <text class="bar-value" x="440" y="38" text-anchor="middle">.352</text>
      <text class="bar-label" x="440" y="120" text-anchor="middle">No-graph</text>
    </g>

    <!-- Three star findings — now at y=300 (below bar chart labels at y=268, gap 32) -->
    <text class="body" x="44" y="300" font-weight="700" fill="#064e3b">&#9733; Real Bloomberg edges beat every alternative (p &lt; .001 vs no-graph LSTM)</text>
    <text class="body" x="850" y="300" font-weight="700" fill="#064e3b">&#9733; Supplier/customer edges reproduce 96% of the gain alone</text>
    <text class="body" x="1610" y="300" font-weight="700" fill="#064e3b">&#9733; Effect stable across walk-forward cutoffs 2021 / 2022 / 2023</text>
  </g>

  <!-- ===== BLOOMBERG DATASET PANEL (shifted to y=556) ===== -->
  <g transform="translate(60,556)">
    <rect x="0" y="8" width="2280" height="200" rx="22" fill="#d97706" opacity="0.18"/>
    <rect class="panel-data" x="0" y="0" width="2280" height="200" rx="22"/>
    <text class="eyebrow-data" x="32" y="38">Dataset &#8901; Novel &amp; Proprietary</text>
    <text class="section-data" x="32" y="74">Bloomberg-Sourced S&amp;P 500 Workbook with Direct Economic Relations</text>
    <text class="body-data" x="32" y="102">Obtained through an industry partnership with a hedge fund &#8212; not a publicly available academic dataset. Combines daily price/volume with rare reference metadata that ordinarily requires Bloomberg Terminal entitlements.</text>

    <g transform="translate(32,126)">
      <rect x="0" y="0" width="350" height="62" rx="14" fill="#ffffff" stroke="#d97706" stroke-width="1.5"/>
      <text class="metric-data" x="20" y="42">500</text>
      <text class="metric-label-data" x="142" y="28">tickers</text>
      <text class="tiny" x="142" y="48">full S&amp;P 500 universe</text>

      <rect x="366" y="0" width="350" height="62" rx="14" fill="#ffffff" stroke="#d97706" stroke-width="1.5"/>
      <text class="metric-data" x="386" y="42">1.83M</text>
      <text class="metric-label-data" x="528" y="28">daily px / volume rows</text>
      <text class="tiny" x="528" y="48">Jan 2015 &#8594; Dec 2024</text>

      <rect x="732" y="0" width="350" height="62" rx="14" fill="#ffffff" stroke="#d97706" stroke-width="1.5"/>
      <text class="metric-data" x="752" y="42">1,062</text>
      <text class="metric-label-data" x="888" y="28">supply-chain edges</text>
      <text class="tiny" x="888" y="48">supplier + customer (directed)</text>

      <rect x="1098" y="0" width="350" height="62" rx="14" fill="#ffffff" stroke="#d97706" stroke-width="1.5"/>
      <text class="metric-data" x="1118" y="42">~72k</text>
      <text class="metric-label-data" x="1240" y="28">holder pairs</text>
      <text class="tiny" x="1240" y="48">Top-20 institutional holders, Jac &#8805; 0.4</text>

      <rect x="1464" y="0" width="752" height="62" rx="14" fill="#fde68a" stroke="#92400e" stroke-width="1.5"/>
      <text class="lock-icon" x="1484" y="38">&#128274;</text>
      <text class="body-data" x="1516" y="28" font-weight="800" fill="#78350f">Proprietary data &#8212; not redistributable</text>
      <text class="tiny" x="1516" y="50" fill="#78350f">Source: Bloomberg Terminal + Data License; accessed via hedge-fund partnership; gitignored in repo.</text>
    </g>
  </g>

  <!-- ===== BOTTOM ROW 1: INTRO PANELS (shifted to y=772, slightly shorter at h=185) ===== -->
  <g transform="translate(60,772)">
    <rect class="panel" x="0" y="0" width="700" height="185" rx="20" filter="url(#softShadow)"/>
    <text class="eyebrow" x="28" y="34">Problem</text>
    <text class="section" x="28" y="64">Market Regimes as Dynamic Graphs</text>
    <text class="body" x="28" y="92">Financial stress is relational: stocks co-move through</text>
    <text class="body" x="28" y="114">sector exposure, ownership, and supply-chain links.</text>
    <rect class="panel-soft" x="28" y="130" width="304" height="42" rx="12"/>
    <text class="body2" x="46" y="156">Regime: Bull, Crash, Liquidity, Stress</text>
    <rect class="panel-soft" x="354" y="130" width="318" height="42" rx="12"/>
    <text class="body2" x="372" y="156">Early warning: Stress in t+5..t+20</text>
  </g>

  <g transform="translate(800,772)">
    <rect class="panel" x="0" y="0" width="700" height="185" rx="20" filter="url(#softShadow)"/>
    <text class="eyebrow" x="28" y="34">Setting A</text>
    <text class="section" x="28" y="64">30-Stock Curated Benchmark</text>
    <text class="body2" x="28" y="90">Yahoo Finance, SPY + VIX context, train 2018-2021, val 2022-2024.</text>
    <g transform="translate(28,104)">
      <rect class="blue" x="0" y="0" width="148" height="70" rx="14"/>
      <text class="metric2" x="18" y="42">30</text>
      <text class="metric-label" x="18" y="61">stocks</text>
      <rect class="blue" x="164" y="0" width="148" height="70" rx="14"/>
      <text class="metric2" x="182" y="42">900</text>
      <text class="metric-label" x="182" y="61">train</text>
      <rect class="blue" x="328" y="0" width="148" height="70" rx="14"/>
      <text class="metric2" x="346" y="42">733</text>
      <text class="metric-label" x="346" y="61">val</text>
      <rect class="blue" x="492" y="0" width="148" height="70" rx="14"/>
      <text class="metric2" x="510" y="42">30</text>
      <text class="metric-label" x="510" y="61">seq len</text>
    </g>
  </g>

  <g transform="translate(1540,772)">
    <rect class="panel" x="0" y="0" width="800" height="185" rx="20" filter="url(#softShadow)"/>
    <text class="eyebrow" x="28" y="34">Setting B</text>
    <text class="section" x="28" y="64">500-Stock S&amp;P 500 Experiment</text>
    <text class="body2" x="28" y="90">Workbook-driven graph using the Bloomberg dataset above.</text>
    <g transform="translate(28,104)">
      <rect class="green" x="0" y="0" width="168" height="70" rx="14"/>
      <text class="metric2" x="18" y="42">500</text>
      <text class="metric-label" x="18" y="61">tickers</text>
      <rect class="green" x="184" y="0" width="178" height="70" rx="14"/>
      <text class="metric2" x="202" y="42">1.83M</text>
      <text class="metric-label" x="202" y="61">rows</text>
      <rect class="green" x="378" y="0" width="178" height="70" rx="14"/>
      <text class="metric2" x="396" y="42">1,062</text>
      <text class="metric-label" x="396" y="61">supply edges</text>
      <rect class="green" x="572" y="0" width="172" height="70" rx="14"/>
      <text class="metric2" x="590" y="42">00:08:44</text>
      <text class="metric-label" x="590" y="61">H200 elapsed</text>
    </g>
  </g>

  <!-- ===== BOTTOM ROW 2: RESULTS PANELS (shifted to y=973, h=417) ===== -->
  <g transform="translate(60,973)">
    <rect class="panel" x="0" y="0" width="700" height="417" rx="20" filter="url(#softShadow)"/>
    <text class="eyebrow" x="28" y="34">Model</text>
    <text class="section" x="28" y="64">Dynamic Regime GNN</text>
    <g transform="translate(36,88)">
      <rect class="chip" x="0" y="0" width="112" height="42" rx="14"/>
      <text class="chip-text" x="56" y="27" text-anchor="middle">Graph seq</text>
      <line x1="122" y1="21" x2="170" y2="21" stroke="#64748b" stroke-width="3"/>
      <polygon points="170,21 160,15 160,27" fill="#64748b"/>
      <rect class="chip2" x="182" y="0" width="112" height="42" rx="14"/>
      <text class="chip-text" x="238" y="27" text-anchor="middle">MLP</text>
      <line x1="306" y1="21" x2="354" y2="21" stroke="#64748b" stroke-width="3"/>
      <polygon points="354,21 344,15 344,27" fill="#64748b"/>
      <rect class="chip" x="366" y="0" width="112" height="42" rx="14"/>
      <text class="chip-text" x="422" y="27" text-anchor="middle">R-GCN</text>
      <line x1="490" y1="21" x2="538" y2="21" stroke="#64748b" stroke-width="3"/>
      <polygon points="538,21 528,15 528,27" fill="#64748b"/>
      <rect class="chip3" x="550" y="0" width="112" height="42" rx="14"/>
      <text class="chip-text" x="606" y="27" text-anchor="middle">LSTM</text>
    </g>

    <g transform="translate(32,150)">
      <rect class="blue" x="0" y="0" width="300" height="116" rx="16"/>
      <text class="subhead" x="18" y="30">Node encoder</text>
      <text class="code" x="18" y="60">37 -&gt; 128</text>
      <text class="body2" x="18" y="88">stock features become node embeddings</text>
    </g>
    <g transform="translate(368,150)">
      <rect class="green" x="0" y="0" width="300" height="116" rx="16"/>
      <text class="subhead" x="18" y="30">Spatial encoder</text>
      <text class="code" x="18" y="60">2-layer R-GCN, hidden=128</text>
      <text class="body2" x="18" y="88">relation-aware message passing</text>
    </g>
    <g transform="translate(32,282)">
      <rect class="amber" x="0" y="0" width="300" height="116" rx="16"/>
      <text class="subhead" x="18" y="30">Temporal encoder</text>
      <text class="code" x="18" y="60">2-layer LSTM, hidden=256</text>
      <text class="body2" x="18" y="88">graph embeddings over time</text>
    </g>
    <g transform="translate(368,282)">
      <rect class="rose" x="0" y="0" width="300" height="116" rx="16"/>
      <text class="subhead" x="18" y="30">Dual heads</text>
      <text class="code" x="18" y="60">regime CE + transition BCE</text>
      <text class="body2" x="18" y="88">1,141,783 trainable parameters</text>
    </g>
  </g>

  <g transform="translate(800,973)">
    <rect class="panel" x="0" y="0" width="700" height="417" rx="20" filter="url(#softShadow)"/>
    <text class="eyebrow" x="28" y="34">Setting A Results</text>
    <text class="section" x="28" y="64">Sparse Graph Performs Best</text>
    <text class="body2" x="28" y="92">Best checkpoint: epoch 2, sparse correlation graph.</text>
    <g transform="translate(28,108)">
      <rect class="green" x="0" y="0" width="200" height="78" rx="15"/>
      <text class="metric" x="18" y="48">0.6385</text>
      <text class="metric-label" x="18" y="68">val accuracy</text>
      <rect class="green" x="226" y="0" width="200" height="78" rx="15"/>
      <text class="metric" x="244" y="48">0.4513</text>
      <text class="metric-label" x="244" y="68">macro-F1</text>
      <rect class="green" x="452" y="0" width="200" height="78" rx="15"/>
